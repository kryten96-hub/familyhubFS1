rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function member(fid) {
      return exists(/databases/$(db)/documents/families/$(fid)/members/$(request.auth.uid));
    }
    function famOwner(fid) {
      return get(/databases/$(db)/documents/families/$(fid)).data.owner;
    }
    match /users/{u} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && member(request.resource.data.fid);
      allow delete: if request.auth != null && member(resource.data.fid);
    }
    match /families/{fid} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow read: if request.auth != null && member(fid);
      allow update: if request.auth != null && member(fid) && request.resource.data.owner == resource.data.owner;
      match /members/{u} {
        allow read: if request.auth != null && member(fid);
        allow create: if request.auth != null && request.auth.uid == u && (
          famOwner(fid) == u || (request.resource.data.code is string && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.fid == fid));
        allow delete: if request.auth != null && member(fid) && (request.auth.uid == u || famOwner(fid) == request.auth.uid);
      }
      match /data/{d} {
        allow read, write: if request.auth != null && member(fid);
      }
      match /tokens/{t} {
        allow read, write: if request.auth != null && member(fid);
      }
    }
  }
}
